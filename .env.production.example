# Azure App Service Authentication must require Entra sign-in and strip caller identity headers.
# The API must not be reachable through a route bypassing that authentication layer.
SAFIMAINT_ENVIRONMENT=production
SAFIMAINT_DEV_AUTH=false
SAFIMAINT_TRUST_AUTH_HEADERS=true
SAFIMAINT_ALLOWED_HOSTS=your-maintenance-host.example.org
SAFIMAINT_OWNER_EMAILS=your-real-owner@example.org
SAFIMAINT_DATABASE_PATH=/app/data/safimaint.db
SAFIMAINT_ATTACHMENT_PATH=/app/data/attachments
SAFIMAINT_MAX_REQUEST_BYTES=28000000
SAFIMAINT_MAX_STATE_BYTES=8000000
# Set only the real proxy IPs if proxy headers are required. Never use '*'.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SafiMaintain <maintenance@example.org>
SMTP_STARTTLS=true
