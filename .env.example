# Local development only. Production must use Microsoft Entra ID / Azure App Service Authentication.
SAFIMAINT_DEV_AUTH=false
SAFIMAINT_DEV_USER_EMAIL=you@company.com
SAFIMAINT_OWNER_EMAILS=operations.manager@company.com
SAFIMAINT_DATABASE_PATH=./data/safimaint.db
SAFIMAINT_ATTACHMENT_PATH=./data/attachments

# Optional SMTP relay for actual alert delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SafiMaintain <maintenance@company.com>
SMTP_STARTTLS=true

